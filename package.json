{
  "name": "@local/dsh-voice-copilot",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test"
  },
  "description": "DSH voice assistant: a floating always-on-top window with wake word, speech-to-text, a dedicated session, and spoken-style replies.",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "agent.js",
    "agents/**",
    "learning.js",
    "pinyin-match.js",
    "name-resolver.js",
    "courses.js",
    "client.js",
    "autostart.js",
    "lease.js",
    "cordis.patch.yml",
    "docs/**",
    ".agents/**",
    "tools/**",
    "!tools/learn_state.json",
    "!tools/local_config.py",
    "!tools/__pycache__/**",
    "locale/*.json",
    "icon.svg",
    "desktop/main.js",
    "desktop/preload.js",
    "desktop/package.json",
    "desktop/lib/**",
    "desktop/ui/**",
    "desktop/assets/**",
    "desktop/data/**"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
