{
  "name": "@local/dsh-voice-copilot",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test"
  },
  "description": "DSH 语音助手（小印）：插件本体在 voice-assistant/，人设与智能体包在 xiaoyin-persona/，托盘浮窗在 tray-app/。",
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "exports": {
    ".": "./voice-assistant/index.js",
    "./client": "./voice-assistant/client.js",
    "./locale/*.json": "./voice-assistant/locale/*.json",
    "./icon": "./voice-assistant/icon.svg"
  },
  "files": [
    "voice-assistant/index.js",
    "voice-assistant/client.js",
    "voice-assistant/agent.js",
    "voice-assistant/autostart.js",
    "voice-assistant/learning.js",
    "voice-assistant/lease.js",
    "voice-assistant/courses.js",
    "voice-assistant/name-resolver.js",
    "voice-assistant/pinyin-match.js",
    "voice-assistant/icon.svg",
    "voice-assistant/locale/*.json",
    "voice-assistant/docs/**",
    "voice-assistant/test/**",
    "voice-assistant/tools/**",
    "xiaoyin-persona/agents/**",
    "xiaoyin-persona/docs/**",
    "xiaoyin-persona/presets/example-assistant/**",
    "xiaoyin-persona/tools/**",
    "!xiaoyin-persona/tools/learn_state.json",
    "!xiaoyin-persona/tools/local_config.py",
    "!xiaoyin-persona/tools/order-samples.jsonl",
    "!xiaoyin-persona/tools/__pycache__/**",
    "tray-app/desktop/main.js",
    "tray-app/desktop/preload.js",
    "tray-app/desktop/package.json",
    "tray-app/desktop/lib/**",
    "tray-app/desktop/ui/**",
    "tray-app/desktop/assets/**",
    "tray-app/desktop/data/**",
    "cordis.patch.yml",
    ".agents/**",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
